# Paste your MongoDB connection string below.
# Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/gharrpay
MONGO_URI=mongodb://localhost:27017/gharrpay
PORT=5000

# Admin dashboard login (change the password!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of allowed frontend origins (dev default)
# CORS_ORIGIN=http://localhost:5173

# Set to 1 behind a reverse proxy (nginx / Render / App Runner)
# TRUST_PROXY=1
